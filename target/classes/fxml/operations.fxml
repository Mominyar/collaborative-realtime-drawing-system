<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="768" prefWidth="1200" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="opsmap.client.OperationsController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="1180.0" spacing="9.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>

            <Label text="Tools" />
            <Button fx:id="penButton" text="Pen" />
            <Button fx:id="arrowButton" text="Arrow" />
            <Button fx:id="circleButton" text="Circle" />
            <Button fx:id="rectangleButton" text="Rectangle" />
            <Button fx:id="pinButton" text="Pin" />
            <Button fx:id="textButton" text="Text" />
            <Button fx:id="eraserButton" text="Eraser" />

            <Label text="Shape Size" />
            <ComboBox fx:id="thicknessCombo" promptText="Size" />

            <Label text="Text Size" />
            <ComboBox fx:id="textSizeCombo" promptText="Size" />

            <Label text="Colors" />

            <Button fx:id="colorWhiteButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="WHITE" height="14" stroke="BLACK" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorBlackButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="BLACK" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorRedButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="RED" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorYellowButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="YELLOW" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorGreenButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="GREEN" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorBlueButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="BLUE" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorBrownButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="#8B4513" height="14" width="14" />
                </graphic>
            </Button>
            <Button fx:id="colorGrayButton" prefHeight="22" prefWidth="22">
                <graphic>
                    <Rectangle fill="GRAY" height="14" width="14" />
                </graphic>
            </Button>


            <HBox alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER" spacing="4">
                    <padding>
                        <Insets bottom="4" left="8" right="8" top="4" />
                    </padding>

                    <Label fx:id="userNameLabel" style="-fx-font-size: 16px;                                   -fx-font-weight: bold;                                   -fx-background-color: #f2f2f2;                                   -fx-padding: 2 6 2 6;                                   -fx-background-radius: 4;" />

                    <Label fx:id="userPositionLabel" style="-fx-font-size: 12px;                                   -fx-background-color: #f2f2f2;                                   -fx-padding: 2 6 2 6;                                   -fx-background-radius: 4;" />
                </VBox>

            </HBox>
        </HBox>
    </top>

    <center>
        <Pane fx:id="mapPane" prefHeight="400" prefWidth="600" />
    </center>

    <right>
        <VBox prefWidth="240" spacing="8">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label text="Online Users" />
            <ListView fx:id="userListView" prefHeight="150" />

            <Separator />

            <Label text="Chat" />
            <TextArea fx:id="chatLog" editable="false" prefHeight="200" wrapText="true" />
            <TextArea fx:id="chatInput" promptText="Type message..." wrapText="true" />
            <Button onAction="#sendChatMessage" text="Send" />
            <Label fx:id="statusLabel" />
        </VBox>
    </right>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

</BorderPane>